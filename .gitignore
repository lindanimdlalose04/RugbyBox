# One ignore file for the whole repository. Patterns starting **/ apply in
# every project folder.

# Per-player fetch caches. Each is rebuilt by its project's fetch stage.
**/data/raw/players/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Solver working files
*.lp
*.mps
*.sol

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Office lock files
~$*
